# Email delivery (Resend) — required for the inquiry form to send emails.
RESEND_API_KEY=
RESEND_FROM_EMAIL=

# Analytics (optional) — scripts load only when these are set.
NEXT_PUBLIC_GA_ID=
NEXT_PUBLIC_FB_PIXEL_ID=

# Instagram feed (optional) — Behold.so feed ID. Empty = "Follow on Instagram" fallback shown.
# Set up a free feed at behold.so, add a hashtag filter to control which posts appear.
NEXT_PUBLIC_BEHOLD_FEED_ID=
